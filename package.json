{
  "name": "xperience-vision",
  "version": "1.0.0",
  "private": true,
  "description": "Site XPERIENCE VISION — intégrateur digital automobile premium",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
    "build:webp": "node scripts/webp.js",
    "fetch:images": "node scripts/fetch-product-images.js",
    "fetch:images:dry": "node scripts/fetch-product-images.js --dry-run",
    "rename:images": "node scripts/rename-static-images.js",
    "apply:images": "node scripts/apply-product-images.js",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "nodemailer": "^8.0.5",
    "stripe": "^22.0.2"
  }
}
